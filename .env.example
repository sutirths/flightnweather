# Runtime
ENVIRONMENT=local
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=300

# local | s3
LAKE_PROVIDER=local
LOCAL_LAKE_PATH=./data/lake
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# duckdb | bigquery
WAREHOUSE_PROVIDER=duckdb
DUCKDB_PATH=./data/warehouse/flight_weather.duckdb
BIGQUERY_PROJECT=
BIGQUERY_DATASET=flight_weather

# API configuration
# OpenSky works anonymously with rate limits. Add credentials for higher limits.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_BBOX=-125.0,24.0,-66.0,49.0
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

